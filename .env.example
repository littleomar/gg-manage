SERIAL_PORT=/dev/ttyUSB2
SERIAL_BAUD=115200

# Optional: separate URC port (Quectel modems deliver URCs on a different port)
# SERIAL_URC_PORT=/dev/ttyUSB0

TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHAT_ID=987654321

# Optional: HTTP or SOCKS proxy for Telegram API
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080

# SMS polling interval in milliseconds (default: 60000)
SMS_POLL_INTERVAL_MS=60000

# giffgaff credentials for /account auto-login (no manual cookie required).
# When set, /account fetches the dashboard, intercepts the MFA SMS,
# verifies it, and parses the balance.
# GG_USERNAME=your-member-name
# GG_PASSWORD=your-password
